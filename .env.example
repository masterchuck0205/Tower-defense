# Copy to .env (never commit .env). Render sets PORT and DATABASE_URL for you.
PORT=3000
# PostgreSQL connection string. Leave empty to run with an in-memory store (accounts reset on restart).
DATABASE_URL=
# Set to "false" if your database does not use SSL (typical for a local Postgres)
DATABASE_SSL=true
# Players needed before the host can start (default 2; use 1 to test alone)
MIN_PLAYERS=2
# Maximum simultaneous rooms on this server (default 40)
MAX_ROOMS=40
# How long a disconnected player keeps their seat during a match, in ms (default 120000)
RECONNECT_GRACE_MS=120000
# Only needed if the game page is served from a different domain than this server (comma separated origins)
CORS_ORIGIN=
